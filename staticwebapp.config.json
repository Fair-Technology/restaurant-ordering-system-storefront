{
  "routes": [
    { "route": "/", "rewrite": "/api/shopShell" },
    { "route": "/shops/*", "rewrite": "/api/shopShell" },
    { "route": "/legal/*", "rewrite": "/api/shopShell" },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.svg",
      "/*.ico",
      "/*.txt",
      "/*.woff",
      "/*.woff2",
      "/*.xml",
      "/*.webmanifest",
      "/*.json",
      "/*.map",
      "/.env",
      "/.git/*",
      "/swagger.json",
      "/staticwebapp.config.json"
    ]
  }
}
