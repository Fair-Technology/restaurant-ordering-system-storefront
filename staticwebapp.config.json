{
  "routes": [
    { "route": "/shops/*", "rewrite": "/api/shopShell" },
    { "route": "/legal/*", "rewrite": "/api/shopShell" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.svg",
      "/*.ico",
      "/*.txt",
      "/*.woff",
      "/*.woff2"
    ]
  }
}
